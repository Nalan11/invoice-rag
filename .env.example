# LLM Provider (OpenAI-compatible endpoint)
# Groq (free tier available): https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# PostgreSQL Database
# Use 'localhost' for local development, 'db' when running inside Docker Compose
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_insight
